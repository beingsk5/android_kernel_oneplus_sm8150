 include/linux/bpf_verifier.h |  13 +++
 kernel/bpf/trampoline.c      |  22 ++++-
 kernel/bpf/verifier.c        | 183 +++++++++++++++++++----------------
 4 files changed, 145 insertions(+), 92 deletions(-)

