 	WARN_ON_ONCE(!mutex_is_locked(&aux->poke_mutex));
 
@@ -809,7 +799,7 @@ static void prog_array_map_poke_run(struct bpf_map *map, u32 key,
 			    poke->tail_call.key != key)
