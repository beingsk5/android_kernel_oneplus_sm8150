 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/net/core/filter.c b/net/core/filter.c
index 77ef2781a0df2..c4bce2b76892a 100644
--- a/net/core/filter.c
+++ b/net/core/filter.c
@@ -6026,7 +6026,7 @@ BPF_CALL_3(bpf_sk_assign, struct sk_buff *, skb, struct sock *, sk, u64, flags)
 		return -EOPNOTSUPP;
