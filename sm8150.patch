 net/ipv4/tcp.c           |  6 ++++
 net/ipv4/tcp_input.c     | 35 +++++++++++++++++++++++
 net/ipv4/tcp_minisocks.c | 19 +++++++++++++
 net/ipv4/tcp_output.c    | 61 ++++++++++++++++++++++++++++++++++++++--
 7 files changed, 135 insertions(+), 5 deletions(-)

