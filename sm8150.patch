+
 struct compat_group_req {
 	__u32				 gr_interface;
 	struct __kernel_sockaddr_storage gr_group
@@ -860,8 +867,9 @@ COMPAT_SYSCALL_DEFINE2(socketcall, int, call, u32 __user *, args)
 				compat_ptr(a[3]), a[4]);
 		break;
 	case SYS_GETSOCKOPT:
