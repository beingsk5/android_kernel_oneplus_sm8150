 {
+	struct xdp_txq_info txq = { .dev = dev };
 	u32 act;
 
+	xdp->txq = &txq;
+
 	act = bpf_prog_run_xdp(xdp_prog, xdp);
 	switch (act) {
 	case XDP_PASS:
diff --git a/net/core/filter.c b/net/core/filter.c
index dd7861ca7cc35..15c7f99215f41 100644
--- a/net/core/filter.c
+++ b/net/core/filter.c
@@ -7124,6 +7124,13 @@ static bool xdp_is_valid_access(int off, int size,
 				const struct bpf_prog *prog,
