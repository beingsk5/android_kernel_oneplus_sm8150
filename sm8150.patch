 			    src_reg->type == PTR_TO_PACKET) ||
 			   (reg_is_init_pkt_pointer(dst_reg, PTR_TO_PACKET) &&
@@ -7859,6 +7932,7 @@ static bool try_match_pkt_pointers(const struct bpf_insn *insn,
