+++ b/tools/include/uapi/linux/bpf.h
@@ -1614,6 +1614,13 @@ union bpf_attr {
  * 		Grow or shrink the room for data in the packet associated to
  * 		*skb* by *len_diff*, and according to the selected *mode*.
  *
