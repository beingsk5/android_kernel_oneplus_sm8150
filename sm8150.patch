  *		To achieve this, the helper needs *task*, which is a valid
  *		pointer to struct task_struct. To store the stacktrace, the
  *		bpf program provides *buf* with	a nonnegative *size*.
@@ -3371,6 +3373,7 @@ union bpf_attr {
  *
  *		**BPF_F_USER_STACK**
