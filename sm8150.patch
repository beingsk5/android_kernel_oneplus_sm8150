diff --git a/include/net/udp_tunnel.h b/include/net/udp_tunnel.h
index 5049e4c7da15e..18ab8d122935d 100644
--- a/include/net/udp_tunnel.h
+++ b/include/net/udp_tunnel.h
@@ -112,6 +112,7 @@ struct udp_tunnel_info {
