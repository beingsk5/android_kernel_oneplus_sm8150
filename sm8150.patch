 	struct iovec iov;
 	struct bio_vec *bvec;
@@ -1434,43 +1434,32 @@ struct bio *bio_map_user_iov(struct request_queue *q,
 	if (!pages)
 		goto out;
 
-	iov_for_each(iov, i, *iter) {
