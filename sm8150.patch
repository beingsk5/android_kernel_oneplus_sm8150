 sock_filter_func_proto(enum bpf_func_id func_id, const struct bpf_prog *prog)
@@ -6291,6 +6292,8 @@ sock_filter_func_proto(enum bpf_func_id func_id, const struct bpf_prog *prog)
 	case BPF_FUNC_get_cgroup_classid:
