 1 file changed, 3 deletions(-)

diff --git a/kernel/bpf/core.c b/kernel/bpf/core.c
index b41d4e082d3a9..8fa4bc3620d28 100644
--- a/kernel/bpf/core.c
+++ b/kernel/bpf/core.c
@@ -678,9 +678,6 @@ static struct bpf_prog *bpf_prog_kallsyms_find(unsigned long addr)
 {
 	struct latch_tree_node *n;
 
